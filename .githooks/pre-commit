#!/bin/sh
# Regenerate the production lockfile (no DEV_LOCAL) before every commit.
# This ensures .pnpm-prod/pnpm-lock.yaml always reflects published packages.

echo "pre-commit: regenerating .pnpm-prod/pnpm-lock.yaml..."

mkdir -p .pnpm-prod
DEV_LOCAL=false pnpm install --lockfile-dir .pnpm-prod --lockfile-only --silent

if [ $? -ne 0 ]; then
  echo "ERROR: failed to generate .pnpm-prod/pnpm-lock.yaml" >&2
  exit 1
fi

git add .pnpm-prod/pnpm-lock.yaml
