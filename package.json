{
  "name": "@cpdevtools/git-flow-monorepo",
  "version": "0.0.0-MAIN",
  "private": true,
  "description": "Git-based versioning and release workflow automation",
  "scripts": {
    "prepare": "wireit",
    "build": "wireit",
    "test": "wireit",
    "typecheck": "wireit",
    "lint": "pnpm -r lint",
    "fix": "wireit",
    "format": "wireit",
    "check": "wireit",
    "clean": "wireit",
    "reset": "wireit"
  },
  "wireit": {
    "prepare": {
      "dependencies": [
        "prepare.husky"
      ]
    },
    "prepare.husky": {
      "command": "husky",
      "files": [
        ".husky/**"
      ],
      "output": []
    },
    "build": {
      "dependencies": [
        "./packages/git-flow:build",
        "./packages/cli:build"
      ]
    },
    "test": {
      "dependencies": ["./packages/git-flow:test"]
    },
    "typecheck": {
      "dependencies": ["./packages/git-flow:typecheck", "./packages/cli:typecheck"]
    },
    "fix": {
      "dependencies": [
        "fix.syncpack",
        "fix.git-remove-tags"
      ]
    },
    "fix.deps": {
      "command": "devutil dep-versions fix .publish/deps.yml"
    },
    "fix.git-remove-tags": {
      "command": "git tag | xargs -r git tag -d"
    },
    "fix.syncpack": {
      "command": "syncpack fix-mismatches",
      "dependencies": [
        "fix.deps"
      ]
    },
    "format": {
      "dependencies": [
        "format.prettier",
        "format.projects"
      ]
    },
    "format.syncpack": {
      "command": "syncpack format"
    },
    "format.prettier": {
      "command": "prettier --write \"**/*.{ts,js,json,md,yml}\"",
      "dependencies": [
        "format.syncpack"
      ]
    },
    "format.projects": {
      "command": "devutil run format"
    },
    "check": {
      "dependencies": [
        "check.deps",
        "check.syncpack"
      ]
    },
    "check.deps": {
      "command": "devutil dep-versions check .publish/deps.yml"
    },
    "check.syncpack": {
      "command": "syncpack list-mismatches"
    },
    "clean": {
      "dependencies": [
        "clean.git",
        "pnpm.install"
      ]
    },
    "clean.git": {
      "command": "git clean -dfX",
      "cache": false
    },
    "reset": {
      "dependencies": [
        "reset.git",
        "pnpm.install"
      ]
    },
    "reset.git": {
      "command": "git reset --hard",
      "cache": false
    },
    "pnpm.install": {
      "command": "pnpm install",
      "cache": false
    }
  },
  "devDependencies": {
    "@cpdevtools/ts-dev-utilities-cli": "file:../ts-dev-utilities/packages/cli",
    "@types/node": "^20.17.11",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "syncpack": "^13.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "wireit": "^0.14.13"
  },
  "keywords": [
    "git",
    "github-actions",
    "release",
    "versioning",
    "workflow"
  ],
  "author": "CPDevTools",
  "license": "MIT",
  "repository": "cpdevtools/git-flow.git",
  "bugs": "https://github.com/cpdevtools/git-flow/issues",
  "homepage": "https://github.com/cpdevtools/git-flow#readme",
  "engines": {
    "node": ">=24"
  }
}
