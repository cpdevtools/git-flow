{
  "name": "@cpdevtools/git-flow-monorepo",
  "version": "0.0.0-MAIN",
  "private": true,
  "description": "Git-based versioning and release workflow automation",
  "scripts": {
    "build": "pnpm -r build",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml}\"",
    "lint": "pnpm -r lint",
    "prepare": "husky || true",
    "syncpack.fix": "syncpack fix-mismatches",
    "syncpack.format": "syncpack format",
    "syncpack.list": "syncpack list-mismatches",
    "dep-versions.check": "devutil dep-versions check .publish/deps.yml",
    "dep-versions.fix": "devutil dep-versions fix .publish/deps.yml",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.17.11",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "syncpack": "^13.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "git",
    "github-actions",
    "release",
    "versioning",
    "workflow"
  ],
  "author": "CPDevTools",
  "license": "MIT",
  "repository": "cpdevtools/git-flow.git",
  "bugs": "https://github.com/cpdevtools/git-flow/issues",
  "homepage": "https://github.com/cpdevtools/git-flow#readme",
  "engines": {
    "node": ">=24"
  }
}
