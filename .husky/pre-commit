echo "pre-commit: regenerating .pnpm-prod/pnpm-lock.yaml..."

mkdir -p .pnpm-prod
DEV_LOCAL=false pnpm install --lockfile-dir .pnpm-prod --lockfile-only --config.minimumReleaseAge=0 --silent

if [ $? -ne 0 ]; then
  echo "ERROR: failed to generate .pnpm-prod/pnpm-lock.yaml" >&2
  exit 1
fi

git add .pnpm-prod/pnpm-lock.yaml
