# Transitional poison guard: the dev-link overlay never touches lockfiles or
# manifests, so a file:/devcontainer path can only be a leftover from the
# retired DEV_LOCAL pnpmfile mechanism. Drop this guard once every repo is
# converted (see webservice-deploy-gateway/migrations/dev-link-conversion.md).
if grep -q 'file:/devcontainer' pnpm-lock.yaml package.json packages/*/package.json 2>/dev/null; then
  echo "pre-commit FAILED: file:/devcontainer path in lockfile or manifest (dev-local leak)" >&2
  exit 1
fi
