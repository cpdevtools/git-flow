{
  "name": "@cpdevtools/git-flow-cli",
  "version": "0.0.0-MAIN",
  "description": "CLI tools for Git-based versioning and release workflows",
  "bin": {
    "gitflow": "./dist/bin.js"
  },
  "scripts": {
    "build": "wireit",
    "format": "prettier --write \"src/**/*.ts\"",
    "github.actions.build": "pnpm build",
    "github.actions.pack": "gitflow pack",
    "github.actions.test": "pnpm test",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "typecheck": "wireit"
  },
  "dependencies": {
    "@cpdevtools/git-flow": "workspace:*",
    "@oclif/core": "^4.8.0",
    "@oclif/plugin-autocomplete": "^3.2.40",
    "@oclif/plugin-help": "^6.2.37",
    "prompts": "^2.4.2",
    "semver": "^7.8.5",
    "yaml": "^2.8.2",
    "zx": "^8.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.11",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "cli",
    "git",
    "gitflow",
    "release"
  ],
  "author": "CPDevTools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpdevtools/git-flow.git",
    "directory": "packages/git-flow-cli"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "oclif": {
    "bin": "gitflow",
    "dirname": "gitflow",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ]
  },
  "packageManager": "pnpm@11.5.0",
  "wireit": {
    "build": {
      "command": "tsup",
      "dependencies": [
        "../git-flow:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsup.config.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "dependencies": [
        "../git-flow:build"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ]
    }
  }
}
