{
  "name": "@cpdevtools/git-flow",
  "version": "0.0.0-MAIN",
  "description": "Core library for Git-based versioning and release workflows",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "cpdt-gitflow": "./src/cli/bin.ts"
  },
  "scripts": {
    "build": "tsup",
    "format": "prettier --write \"src/**/*.ts\"",
    "github.actions.build": "pnpm build",
    "github.actions.pack": "pnpm pack",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@cpdevtools/ts-dev-utilities": "^0.2.0",
    "@oclif/core": "^4.8.0",
    "@oclif/plugin-autocomplete": "^3.2.40",
    "@oclif/plugin-help": "^6.2.37",
    "fast-glob": "^3.3.2",
    "semver": "^7.6.3",
    "yaml": "^2.8.2",
    "zx": "^8.2.4"
  },
  "devDependencies": {
    "@types/semver": "^7.5.8",
    "tsx": "^4.19.2"
  },
  "keywords": [
    "branch",
    "git",
    "release",
    "semver",
    "versioning"
  ],
  "author": "CPDevTools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpdevtools/git-flow.git",
    "directory": "packages/git-flow"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./version": {
      "default": "./src/version/index.ts"
    },
    "./branch": {
      "default": "./src/branch/index.ts"
    },
    "./build-pack": {
      "default": "./src/build-pack/index.ts"
    },
    "./publishing": {
      "default": "./src/publishing/index.ts"
    },
    "./publish-release": {
      "default": "./src/publish-release/index.ts"
    },
    "./cli": {
      "default": "./src/cli/index.ts"
    }
  },
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "oclif": {
    "bin": "cpdt-gitflow",
    "dirname": "cpdt-gitflow",
    "commands": "./dist/cli/commands",
    "topicSeparator": " "
  }
}
