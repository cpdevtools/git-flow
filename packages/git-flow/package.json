{
  "name": "@cpdevtools/git-flow",
  "version": "0.0.0-DEFAULT",
  "description": "Core library for Git-based versioning and release workflows",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version/index.d.ts",
      "import": "./dist/version/index.js",
      "require": "./dist/version/index.js"
    },
    "./branch": {
      "types": "./dist/branch/index.d.ts",
      "import": "./dist/branch/index.js",
      "require": "./dist/branch/index.js"
    },
    "./build-pack": {
      "types": "./dist/build-pack/index.d.ts",
      "import": "./dist/build-pack/index.js",
      "require": "./dist/build-pack/index.js"
    },
    "./publishing": {
      "types": "./dist/publishing/index.d.ts",
      "import": "./dist/publishing/index.js",
      "require": "./dist/publishing/index.js"
    },
    "./publish-release": {
      "types": "./dist/publish-release/index.d.ts",
      "import": "./dist/publish-release/index.js",
      "require": "./dist/publish-release/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "require": "./dist/cli/index.js"
    }
  },
  "bin": {
    "cpdt-gitflow": "./dist/cli/bin.js"
  },
  "oclif": {
    "bin": "cpdt-gitflow",
    "dirname": "cpdt-gitflow",
    "commands": "./dist/cli/commands",
    "topicSeparator": " "
  },
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "github.actions.build": "pnpm build",
    "github.actions.pack": "pnpm pack --pack-destination ${ARTIFACT_OUTPUT_DIR} && node scripts/generate-artifact.js"
  },
  "keywords": [
    "git",
    "versioning",
    "semver",
    "release",
    "branch"
  ],
  "author": "CPDevTools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpdevtools/git-flow.git",
    "directory": "packages/git-flow"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@cpdevtools/ts-dev-utilities": "^0.1.0",
    "@oclif/core": "^4.8.0",
    "@oclif/plugin-autocomplete": "^3.2.40",
    "@oclif/plugin-help": "^6.2.37",
    "globby": "^14.0.2",
    "semver": "^7.6.3",
    "yaml": "^2.8.2",
    "zx": "^8.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
