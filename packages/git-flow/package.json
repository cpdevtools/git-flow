{
  "name": "@cpdevtools/git-flow",
  "version": "0.0.0-MAIN",
  "packageManager": "pnpm@11.5.0",
  "description": "Core library for Git-based versioning and release workflows",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "wireit",
    "format": "prettier --write \"src/**/*.ts\"",
    "github.actions.build": "pnpm build",
    "github.actions.pack": "pnpm pack",
    "lint": "eslint src --ext .ts",
    "test": "wireit",
    "typecheck": "wireit"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@cpdevtools/ts-dev-utilities": "^0.4.0-dev.2",
    "fast-glob": "^3.3.2",
    "semver": "^7.6.3",
    "yaml": "^2.8.2",
    "zx": "^8.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.11",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "branch",
    "git",
    "release",
    "semver",
    "versioning"
  ],
  "author": "CPDevTools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpdevtools/git-flow.git",
    "directory": "packages/git-flow"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./version": {
      "default": "./src/version/index.ts"
    },
    "./branch": {
      "default": "./src/branch/index.ts"
    },
    "./build-pack": {
      "default": "./src/build-pack/index.ts"
    },
    "./publishing": {
      "default": "./src/publishing/index.ts"
    },
    "./publish-release": {
      "default": "./src/publish-release/index.ts"
    },
    "./artifacts": {
      "default": "./src/artifacts/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "wireit": {
    "build": {
      "command": "tsup",
      "files": [
        "src/**/*.ts",
        "tsup.config.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "build"
      ],
      "files": [
        "src/**/*.ts",
        "vitest.config.ts"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ]
    }
  }
}
