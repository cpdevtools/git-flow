{
  "name": "@cpdevtools/git-flow-deploy-service",
  "version": "0.0.0-MAIN",
  "description": "Deploy gateway service for git-flow",
  "author": "CPDevTools",
  "license": "MIT",
  "files": ["dist"],
  "scripts": {
    "build": "wireit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "github.actions.build": "wireit",
    "github.actions.pack": "gitflow pack",
    "github.actions.test": "pnpm test",
    "github.actions.test:integration": "pnpm test:e2e",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cpdevtools/git-flow-deploy": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "minimatch": "^10.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@cpdevtools/git-flow-deploy$": "<rootDir>/../../git-flow-deploy/src/index.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "wireit": {
    "build": {
      "command": "nest build",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "tsconfig.build.json",
        "nest-cli.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "build:bundle": {
      "command": "cd ../.. && rm -rf packages/git-flow-deploy-service/.docker-bundle && pnpm deploy --legacy --filter @cpdevtools/git-flow-deploy-service --prod packages/git-flow-deploy-service/.docker-bundle && pnpm install --lockfile-dir .pnpm-prod --filter @cpdevtools/git-flow-deploy-service --config.confirmModulesPurge=false",
      "dependencies": [
        "build",
        "../git-flow-deploy:build"
      ],
      "files": [
        "../../pnpm-workspace.yaml",
        "../../pnpm-lock.yaml",
        "../../packages/git-flow-deploy/package.json"
      ],
      "output": []
    },
    "build:docker": {
      "command": "cd ../.. && docker build -f packages/git-flow-deploy-service/Dockerfile -t git-flow-deploy-service:${PROJECT_VERSION} -t git-flow-deploy-service:latest packages/git-flow-deploy-service/.docker-bundle",
      "dependencies": [
        "build:bundle"
      ],
      "env": {
        "PROJECT_VERSION": {
          "external": true,
          "default": "dev"
        }
      },
      "files": [
        "Dockerfile"
      ],
      "output": []
    },
    "github.actions.build": {
      "dependencies": [
        "build:docker"
      ]
    }
  }
}
