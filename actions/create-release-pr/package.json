{
  "name": "create-release-pr",
  "version": "0.0.0-DEFAULT",
  "private": true,
  "description": "GitHub composite action to create release PRs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-actions",
    "release",
    "pr",
    "versioning"
  ],
  "author": "CPDevTools",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "yaml": "^2.8.2",
    "@cpdevtools/git-flow": "workspace:*",
    "@cpdevtools/ts-dev-utilities": "^0.2.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {}
}
